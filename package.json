{
  "name": "claude-code-usage-monitor",
  "displayName": "Usage Monitor - Claude Code",
  "description": "Monitor Claude Code API usage in VS Code with real-time statistics",
  "version": "0.1.2",
  "publisher": "kimchikingdom",
  "license": "MIT",
  "author": "kimchikingdom",
  "contributors": [
    "kimchikingdom",
    "prafandy"
  ],
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/kimchikingdom/Claude-Usage-Monitor.git"
  },
  "bugs": {
    "url": "https://github.com/kimchikingdom/Claude-Usage-Monitor/issues"
  },
  "homepage": "https://github.com/kimchikingdom/Claude-Usage-Monitor#readme",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "claude",
    "anthropic",
    "api",
    "usage",
    "monitoring",
    "statistics"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "claude-usage-monitor.refresh",
        "title": "Refresh Claude Usage",
        "category": "Claude Usage Monitor"
      },
      {
        "command": "claude-usage-monitor.showDetails",
        "title": "Show Detailed Usage",
        "category": "Claude Usage Monitor"
      },
      {
        "command": "claude-usage-monitor.login",
        "title": "Login to Claude Code",
        "category": "Claude Usage Monitor"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "claude-usage-monitor",
          "title": "Claude Usage Monitor",
          "icon": "resources/claude-icon.svg"
        }
      ]
    },
    "views": {
      "claude-usage-monitor": [
        {
          "id": "claude-usage-monitor.usageTree",
          "name": "Usage Statistics"
        },
        {
          "id": "claude-usage-monitor.detailsView",
          "name": "Detailed Statistics",
          "type": "webview"
        }
      ]
    },
    "configuration": {
      "title": "Claude Usage Monitor",
      "properties": {
        "claude-usage-monitor.updateInterval": {
          "type": "number",
          "default": 60,
          "description": "Update interval in seconds (default: 1 minute)",
          "minimum": 60
        },
        "claude-usage-monitor.showNotifications": {
          "type": "boolean",
          "default": true,
          "description": "Show notifications when usage is high"
        },
        "claude-usage-monitor.warningThreshold": {
          "type": "number",
          "default": 90,
          "description": "Warning threshold percentage (default: 90%)",
          "minimum": 0,
          "maximum": 100
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile",
    "test": "jest",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^20.10.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^2.22.0",
    "jest": "^30.2.0",
    "ts-jest": "^29.4.6",
    "typescript": "^5.3.0"
  }
}
